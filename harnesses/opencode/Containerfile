ARG BASE_IMAGE=ghcr.io/torbett90/ai-sandbox-base:latest
FROM ${BASE_IMAGE}

USER root

# Install OpenCode CLI globally
RUN npm install -g opencode-ai && npm cache clean --force

COPY harness-entrypoint.sh /usr/local/bin/harness-entrypoint.sh
RUN chmod +x /usr/local/bin/harness-entrypoint.sh

USER sandbox
ENV SANDBOX_DIR_NAME=".oc-sandbox"
WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/harness-entrypoint.sh"]
CMD ["opencode"]
