ARG BASE_IMAGE=ghcr.io/torbett90/ai-sandbox-base:latest
FROM ${BASE_IMAGE}

USER root

# Install OpenCode v2 CLI globally (pass --unsafe-perm so postinstall binary selection succeeds cleanly)
RUN npm install -g --unsafe-perm @opencode/cli@latest && \
    npm cache clean --force && \
    mkdir -p /home/sandbox/.local/share/opencode/log /home/sandbox/.config/opencode && \
    chown -R sandbox:sandbox /home/sandbox

COPY harness-entrypoint.sh /usr/local/bin/harness-entrypoint.sh
RUN chmod +x /usr/local/bin/harness-entrypoint.sh

USER sandbox
ENV SANDBOX_DIR_NAME=".oc-sandbox"
WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/harness-entrypoint.sh"]
CMD ["opencode"]
